<yandex>
	<storage_configuration>
		<disks>
			<hdd1>
				<path>/hdd1/</path>
			</hdd1>
			<hdd2>
				<path>/hdd2/</path>
			</hdd2>
			<s3>
				<type>s3</type>
				<endpoint>{{ conf.s3.endpoint }}/{{ conf.s3.cloud_storage_bucket }}-{{ instance_id }}/data/</endpoint>
				<access_key_id>{{ conf.s3.access_key_id }}</access_key_id>
				<secret_access_key>{{ conf.s3.access_secret_key }}</secret_access_key>
			</s3>
			<s3_second>
				<type>s3</type>
				<endpoint>{{ conf.s3.endpoint }}/{{ conf.s3.cloud_storage_bucket }}-{{ instance_id }}/data_second/</endpoint>
				<access_key_id>{{ conf.s3.access_key_id }}</access_key_id>
				<secret_access_key>{{ conf.s3.access_secret_key }}</secret_access_key>
				<skip_access_check>true</skip_access_check>
			</s3_second>
			<s3_multipart>
				<type>s3</type>
				<endpoint>{{ conf.s3.endpoint }}/{{ conf.s3.cloud_storage_bucket }}-{{ instance_id }}/data_multipart/</endpoint>
				<access_key_id>{{ conf.s3.access_key_id }}</access_key_id>
				<secret_access_key>{{ conf.s3.access_secret_key }}</secret_access_key>
				<skip_access_check>true</skip_access_check>
				<!-- Request settings of a disk are read with the "s3_" prefix and
				     the bare name is ignored without a word, so the prefix stays.
				     An object above the copy size is copied in several parts, and
				     5 MiB is the smallest part S3 accepts, so a copy of several
				     parts is made by an object that fits into a test environment. -->
				<s3_max_single_operation_copy_size>5242880</s3_max_single_operation_copy_size>
				<s3_min_upload_part_size>5242880</s3_min_upload_part_size>
				<!-- Writes stay in a single part, so that a multipart ETag in the
				     backup bucket can only have been left by the copy. -->
				<s3_max_single_part_upload_size>1073741824</s3_max_single_part_upload_size>
			</s3_multipart>
			<s3_load>
				<type>s3</type>
				<endpoint>{{ conf.s3.endpoint }}/{{ conf.s3.cloud_storage_bucket }}-{{ instance_id }}/data_load/</endpoint>
				<access_key_id>{{ conf.s3.access_key_id }}</access_key_id>
				<secret_access_key>{{ conf.s3.access_secret_key }}</secret_access_key>
				<skip_access_check>true</skip_access_check>
			</s3_load>
{% if ch_version_ge('22.8') %}
			<s3_cache>
				<type>cache</type>
				<disk>s3</disk>
				<path>/var/lib/clickhouse/disks/s3_cache</path>
				<max_size>1024000000</max_size>
			</s3_cache>
{% endif %}
		</disks>

		<policies>
			<multiple_disks>
				<volumes>
					<main>
						<disk>default</disk>
					</main>
					<hdd1>
						<disk>hdd1</disk>
					</hdd1>
					<hdd2>
						<disk>hdd2</disk>
					</hdd2>
				</volumes>
				<move_factor>0.0</move_factor> <!-- Disable automatic moves -->
			</multiple_disks>

			<s3>
				<volumes>
					<main>
{% if ch_version_ge('22.8') %}
						<disk>s3_cache</disk>
{% else %}
						<disk>s3</disk>
{% endif %}
					</main>
					<external>
						<disk>default</disk>
					</external>
				</volumes>
				<move_factor>0.0</move_factor> <!-- Disable automatic moves -->
			</s3>

			<multiple_s3>
				<volumes>
					<main>
						<disk>s3</disk>
					</main>
					<second>
						<disk>s3_second</disk>
					</second>
				</volumes>
				<move_factor>0.0</move_factor> <!-- Disable automatic moves -->
			</multiple_s3>

			<s3_multipart>
				<volumes>
					<main>
						<disk>s3_multipart</disk>
					</main>
				</volumes>
				<move_factor>0.0</move_factor> <!-- Disable automatic moves -->
			</s3_multipart>

			<s3_load>
				<volumes>
					<main>
						<disk>s3_load</disk>
					</main>
				</volumes>
				<move_factor>0.0</move_factor> <!-- Disable automatic moves -->
			</s3_load>

			<s3_cold>
				<volumes>
					<main>
						<disk>default</disk>
					</main>
					<external>
{% if ch_version_ge('22.8') %}
						<disk>s3_cache</disk>
{% else %}
						<disk>s3</disk>
{% endif %}
					</external>
				</volumes>
				<move_factor>0.0</move_factor> <!-- Disable automatic moves -->
			</s3_cold>
		</policies>
	</storage_configuration>
</yandex>
